%{%(solver/SolverName%)
%:chtMultiRegionSimpleFoam
%{%(multiRegionFluidNames/0%)
%[_header%]
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/%(multiRegionFluidNames/0%)";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform %(initialValues/Temperature%);

boundaryField
{
%{%(multiRegionFluidBoundariesByRegion/%(multiRegionFluidNames/0%)%)
%{%(multiRegionFluidBoundariesByRegion/%(multiRegionFluidNames/0%)/%(0%)/BoundaryType%)
%:wall
%{%(multiRegionFluidBoundariesByRegion/%(multiRegionFluidNames/0%)/%(0%)/BoundarySubType%)
%:regionCoupledWall
    %(0%)
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        value           $internalField;
        Tnbr            T;
        kappaMethod     fluidThermo;
    }
%:default
%{%(boundaries/%(0%)/ThermalBoundaryType%)
%:fixedValue zeroGradient fixedGradient totalPower heatTransferCoeff
    %(0%)
    {
%[0/_cht_wall_temperature%]
%{%(boundaries/%(0%)/ThermalBoundaryType%)
%:fixedGradient totalPower heatTransferCoeff
        kappaMethod     fluidThermo;
        value           $internalField;
%}
    }
%}
%}
%:inlet
    %(0%)
    {
        type        inletOutlet;
        inletValue  uniform %(multiRegionFluidBoundariesByRegion/%(multiRegionFluidNames/0%)/%(0%)/Temperature%);
        value       uniform %(multiRegionFluidBoundariesByRegion/%(multiRegionFluidNames/0%)/%(0%)/Temperature%);
    }
%:outlet
    %(0%)
    {
        type        inletOutlet;
        inletValue  uniform %(multiRegionFluidBoundariesByRegion/%(multiRegionFluidNames/0%)/%(0%)/Temperature%);
        value       $internalField;
    }
%:open
    %(0%)
    {
        type        inletOutlet;
        inletValue  uniform %(multiRegionFluidBoundariesByRegion/%(multiRegionFluidNames/0%)/%(0%)/Temperature%);
        value       $internalField;
    }
%:constraint
%[0/_boundary_constraint%]
%}

%}

%{%(multiRegionUseSplitMeshRegions%)
%:True
%{%(multiRegionSolidNames%)
    %(multiRegionFluidNames/0%)_to_%(multiRegionSolidNames/%(0%)%)
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        value           $internalField;
        Tnbr            T;
        kappaMethod     fluidThermo;
    }

%}
%}
    defaultFaces
    {
        type            zeroGradient;
    }
}

// ************************************************************************* //
%} 0/%(0%)/T
%}
