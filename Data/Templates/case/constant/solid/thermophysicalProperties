%{%(solver/SolverName%)
%:chtMultiRegionSimpleFoam
%{%(multiRegionSolidNames%)
%[_header%]
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/%(multiRegionSolidNames/%(0%)%)";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
%{%(system/FoundationChtModels%)
%:True
    transport       constIsoSolid;
%:False
    transport       constIso;
%}
%{%(system/FoundationChtModels%)
%:True
    thermo          eConst;
%:False
    thermo          hConst;
%}
    equationOfState rhoConst;
    specie          specie;
%{%(system/FoundationChtModels%)
%:True
    energy          sensibleInternalEnergy;
%:False
    energy          sensibleEnthalpy;
%}
}

mixture
{
    specie
    {
        nMoles          1;
        molWeight       1;
    }
    transport
    {
        kappa           %(solidProperties/%(0%)/ThermalConductivity%);
    }
    thermodynamics
    {
%{%(system/FoundationChtModels%)
%:True
        Cv              %(solidProperties/%(0%)/Cp%);
%:False
        Cp              %(solidProperties/%(0%)/Cp%);
%}
        Hf              0;
    }
    equationOfState
    {
        rho             %(solidProperties/%(0%)/Density%);
    }
}

// ************************************************************************* //
%} constant/%(multiRegionSolidNames/%(0%)%)/thermophysicalProperties
%}
